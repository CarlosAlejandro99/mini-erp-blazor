@page "/empleados"
@rendermode InteractiveWebAssembly
@using hola_mundo.Client.Shared
@using hola_mundo.Client.Models
@using hola_mundo.Client.Services
@inject IEmpleadoService EmpleadoService

<PageTitle>Empleados</PageTitle>

<div class="empleados-page">

    <div class="background-effect effect-1"></div>
    <div class="background-effect effect-2"></div>

    <div class="container">

        @if (empleados == null)
        {
            <div class="loading-section">
                <div class="loading-card">
                    <img src="https://assets-v2.lottiefiles.com/a/03cdc6e0-118b-11ee-bf08-07d88a941cbd/fjMdlSoouM.gif"
                         alt="Cargando..." width="90" height="90" />
                    <h3>Cargando información...</h3>
                    <p>Por favor espera un momento...</p>
                </div>
            </div>
        }
        else
        {
            <div class="employees-header">
                <div>
                    <div class="page-badge">
                        <span class="pulse-dot"></span>
                        Sistema de empleados activo
                    </div>
                    <h1>
                        Nuestro equipo
                        <span class="gradient-text">en un solo lugar</span>
                    </h1>
                    <p>
                        Consulta, busca y agrega empleados al directorio de la empresa
                        en tiempo real.
                    </p>
                </div>
                <div class="header-icon">👥</div>
            </div>

            <div class="stats-section">
                <div class="stat-card">
                    <div class="stat-icon purple">👤</div>
                    <div>
                        <span>Total de empleados</span>
                        <strong>@empleados.Count</strong>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon blue">💼</div>
                    <div>
                        <span>Puestos distintos</span>
                        <strong>@PuestosUnicos</strong>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon green">🔎</div>
                    <div>
                        <span>Resultados mostrados</span>
                        <strong>@empleadosFiltrados.Count</strong>
                    </div>
                </div>
            </div>

            <div class="employees-section">

                <div class="section-title">
                    <div>
                        <span class="section-label">DIRECTORIO</span>
                        <h2>Empleados registrados</h2>
                    </div>
                    <span class="employee-count">
                        @empleadosFiltrados.Count de @empleados.Count
                    </span>
                </div>

                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text"
                           class="search-input"
                           placeholder="Buscar por nombre, puesto o correo..."
                           value="@terminoBusqueda"
                           @oninput="OnBuscar" />

                    @if (!string.IsNullOrWhiteSpace(terminoBusqueda))
                    {
                        <button class="clear-search" @onclick="LimpiarBusqueda">✕</button>
                    }
                </div>

                @if (empleadosFiltrados.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-icon">🗂️</div>
                        <p>No se encontraron empleados que coincidan con "@terminoBusqueda".</p>
                    </div>
                }
                else
                {
                    <div class="employees-grid">
                        @foreach (var empleado in empleadosFiltrados)
                        {
                            <TarjetaEmpleado Nombre="@empleado.Nombre"
                                              Puesto="@empleado.Puesto"
                                              Correo="@empleado.Correo" />
                        }
                    </div>
                }

            </div>

            <div class="add-section">
                <div class="add-header">
                    <div class="add-icon">➕</div>
                    <div>
                        <h2>Agregar empleado</h2>
                        <p>Completa los datos para sumarlo al directorio.</p>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="nombreEmpleado">Nombre</label>
                        <input id="nombreEmpleado" type="text" class="form-control custom-input"
                               @bind="nombreEmpleado" placeholder="Ej. Laura Ramírez" />
                    </div>

                    <div class="form-group">
                        <label for="puestoEmpleado">Puesto</label>
                        <input id="puestoEmpleado" type="text" class="form-control custom-input"
                               @bind="puestoEmpleado" placeholder="Ej. Diseñadora UX" />
                    </div>

                    <div class="form-group">
                        <label for="correoEmpleado">Correo</label>
                        <input id="correoEmpleado" type="email" class="form-control custom-input"
                               @bind="correoEmpleado" placeholder="Ej. laura@empresa.com" />
                    </div>
                </div>

                <button class="add-button" @onclick="AgregarEmpleado">
                    ➕ Agregar empleado
                </button>
            </div>

            <p class="storage-info">
                Los datos se mantienen en memoria mientras la aplicación esté abierta.
            </p>
        }

    </div>
</div>

@code {

    private List<Empleado>? empleados;

    private string nombreEmpleado = string.Empty;
    private string puestoEmpleado = string.Empty;
    private string correoEmpleado = string.Empty;

    private string terminoBusqueda = string.Empty;

    private List<Empleado> empleadosFiltrados =>
        empleados is null
            ? new List<Empleado>()
            : empleados.Where(e =>
                string.IsNullOrWhiteSpace(terminoBusqueda) ||
                e.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                e.Puesto.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                e.Correo.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)
              ).ToList();

    private int PuestosUnicos =>
        empleados?.Select(e => e.Puesto).Distinct().Count() ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        empleados = EmpleadoService.ObtenerTodos();
    }

    private void OnBuscar(ChangeEventArgs e)
    {
        terminoBusqueda = e.Value?.ToString() ?? string.Empty;
    }

    private void LimpiarBusqueda()
    {
        terminoBusqueda = string.Empty;
    }

    private void AgregarEmpleado()
    {
        if (!string.IsNullOrWhiteSpace(nombreEmpleado))
        {
            EmpleadoService.Agregar(new Empleado
            {
                Nombre = nombreEmpleado,
                Puesto = string.IsNullOrWhiteSpace(puestoEmpleado) ? "Por definir" : puestoEmpleado,
                Correo = string.IsNullOrWhiteSpace(correoEmpleado) ? "-" : correoEmpleado
            });

            nombreEmpleado = string.Empty;
            puestoEmpleado = string.Empty;
            correoEmpleado = string.Empty;
        }
    }
}