@using hola_mundo.Client.Models

<div class="table-responsive employees-table-wrapper">
    <table class="table table-dark table-hover table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>No. empleado</th>
                <th>Nombre</th>
                <th>Género</th>
                <th>Cumpleaños</th>
                <th>CURP</th>
                <th>Teléfono</th>
                <th>Puesto</th>
                <th>Correo</th>
            </tr>
        </thead>
        <tbody>
            @* Select(...) numera cada empleado dentro de ESTA página (0, 1, 2...);
               se le suma Inicio para que la numeración siga siendo correcta en toda la lista. *@
            @foreach (var (e, i) in Empleados.Select((emp, idx) => (emp, idx)))
            {
                <tr>
                    <th scope="row">@(Inicio + i + 1)</th>
                    <td>@e.NumeroEmpleado</td>
                    <td>@e.Nombre</td>
                    <td>@e.Genero</td>
                    <td>@e.FechaCumpleanos?.ToString("dd/MM/yyyy")</td>
                    <td>@e.CURP</td>
                    <td>@e.Telefono</td>
                    <td><span class="badge bg-primary-subtle text-primary-emphasis">@e.Puesto</span></td>
                    <td>@e.Correo</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    /// Empleados a mostrar (ya filtrados y recortados a una sola página; este componente no filtra ni pagina)
    [Parameter, EditorRequired]
    public IEnumerable<Empleado> Empleados { get; set; } = [];

    /// Cuántos empleados hay antes de esta página, para que la columna "#" no siempre
    /// empiece en 1 (por ejemplo, en la página 2 empieza en 5, 6, 7...).
    
    [Parameter]
    public int Inicio { get; set; }
}
