<div class="employee-card">
    <div class="employee-avatar">@Iniciales</div>

    <div class="employee-info">
        <h5>@Nombre</h5>
        <span class="employee-puesto">@Puesto</span>
        <span class="employee-correo">✉️ @Correo</span>
    </div>
</div>

@code {
    [Parameter]
    public string Nombre { get; set; } = string.Empty;

    [Parameter]
    public string Puesto { get; set; } = string.Empty;

    [Parameter]
    public string Correo { get; set; } = string.Empty;

    private string Iniciales =>
        string.IsNullOrWhiteSpace(Nombre)
            ? "?"
            : string.Concat(Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(p => char.ToUpper(p[0])));
}