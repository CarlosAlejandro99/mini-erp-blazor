@page "/"
@rendermode InteractiveWebAssembly

<PageTitle>Mini ERP | Inicio</PageTitle>

<MostradoLoading />
<div class="container py-5">

    <!-- Encabezado -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Mini ERP</h1>

        <p class="lead text-muted">
            Proyecto desarrollado con Blazor y .NET
        </p>

    </div>

    <!-- Presentación del proyecto -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">

            <h2 class="h4 mb-3">Información del proyecto</h2>

            <p>
                Este proyecto tiene como objetivo practicar los fundamentos
                del lenguaje C# y el desarrollo de aplicaciones web utilizando
                Blazor y .NET.
            </p>

            <p class="mb-0">
                Durante el desarrollo se implementarán conceptos como
                variables, listas, diccionarios, clases, métodos y
                componentes interactivos.
            </p>

        </div>
    </div>

    <!-- Conceptos -->
    <h2 class="h4 text-center mb-4">
        Conceptos de C# que estamos practicando
    </h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">

                    <h3 class="h5">Variables</h3>

                    <p class="text-muted mb-0">
                        Permiten almacenar información utilizando
                        diferentes tipos de datos.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">

                    <h3 class="h5">Listas</h3>

                    <p class="text-muted mb-0">
                        Permiten almacenar colecciones ordenadas
                        de elementos.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">

                    <h3 class="h5">Clases</h3>

                    <p class="text-muted mb-0">
                        Permiten agrupar datos y comportamientos
                        relacionados.
                    </p>

                </div>
            </div>
        </div>

    </div>

    <!-- Pie de página -->
    <div class="text-center text-muted mt-5">
        <small>
            Proyecto académico • C# • Blazor • .NET
        </small>
    </div>

</div>
